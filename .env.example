# Conexión a PostgreSQL.
# - En Vercel la crea la integración de Neon automáticamente.
# - En local puedes usar `npx prisma dev` (imprime una URL postgres://...) o la URL de tu base Neon.
DATABASE_URL="postgres://usuario:clave@host:5432/basedatos"

# Opcional: conexión directa (sin pooler) para migraciones. Neon la entrega como DATABASE_URL_UNPOOLED.
# DATABASE_URL_UNPOOLED="postgres://..."
